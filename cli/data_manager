def data_cleanup():
    shutil.rmtree(DATA_FOLDER, ignore_errors=True)
    DATA_FOLDER.mkdir(parents=True, exist_ok=True)


def create_local_gdac_tree():
    shutil.rmtree(DATA_FOLDER, ignore_errors=True)

    DATA_FOLDER.mkdir(parents=True, exist_ok=True)
    for sub in ["aux", "dac", "etc", "etc/argo-index"]:
        DATA_FOLDER.joinpath(sub).mkdir(parents=True, exist_ok=True)

    idx = ar.ArgoIndex(cache=True)
    idx.query.wmo(WMO_LIST)

    for dac, wmo in idx.read_dac_wmo():
        DATA_FOLDER.joinpath(f"dac/{dac}/{wmo}").mkdir(parents=True, exist_ok=True)
        DATA_FOLDER.joinpath(f"dac/{dac}/{wmo}/profiles").mkdir(
            parents=True, exist_ok=True
        )

        af = ar.ArgoFloat(wmo, cache=True, aux=True)

        if any(["aux" in key for key in af.ls_datasets().keys()]):
            DATA_FOLDER.joinpath(f"aux/{af.dac}/{af.WMO}").mkdir(
                parents=True, exist_ok=True
            )


def list_gdac_files(session: aiohttp.ClientSession) -> dict[str, str]:
    uri = []

    for wmo in WMO_LIST:
        af = ar.ArgoFloat(wmo, cache=True, aux=True)

        for file_remote in af._ls():
            # file_local = DATA_FOLDER.joinpath(file_remote.replace(af.host, "."))
            uri.append(file_remote)

        for file_remote in af._lsp():
            # file_local = DATA_FOLDER.joinpath(file_remote.replace(af.host, "."))
            uri.append(file_remote)

    return uri


async def fetch_download_links(session: aiohttp.ClientSession):
    """Gather the list of all remote ressources to download

    The return list is a list of dictionaries with all the necessary keys to save and retrieve requests offline using
    the fixture of the local HTTP server
    """
    URI = []

    # REQUESTS to: https://data-argo.ifremer.fr
    [URI.append(link) for link in list_gdac_files(session)]

    # Return the list of dictionaries
    return URI


def can_be_xr_opened(src, file):
    try:
        xr.open_dataset(file)
        return src
    except:
        # print("This source can't be opened with xarray: %s" % src)
        return src


async def place_file(session: aiohttp.ClientSession, source: dict) -> None:
    """Download remote file and save it locally"""
    test_data_file = DATA_FOLDER.joinpath(source["uri"].replace(OPTIONS["gdac"], ""))

    if OVERWRITE or not test_data_file.exists():
        async with session.get(source["uri"], ssl=False, timeout=60 * 5) as r:
            if r.content_type not in CONTENT_TYPE.values():
                print(
                    "Unexpected content type (%s) with this GET request: %s (%s extension)"
                    % (
                        r.content_type,
                        source["uri"],
                        os.path.splitext(urlparse(source["uri"]).path)[1],
                    )
                )

            Path(os.path.dirname(test_data_file)).mkdir(parents=True, exist_ok=True)
            async with aiofiles.open(test_data_file, "wb") as f:
                data = await r.content.read(n=-1)  # load all read bytes !
                await f.write(data)
                # print(log_file_desc(f.name))
                return can_be_xr_opened(source, test_data_file)
    else:
        # print("%s already exists !" % test_data_file)
        return can_be_xr_opened(source, test_data_file)


async def download():
    connector = aiohttp.TCPConnector(limit=1, force_close=True)
    async with aiohttp.ClientSession(connector=connector) as session:
        urls = await fetch_download_links(session)
        # return await asyncio.gather(*[place_file(session, url) for url in urls])
        # await tqdm_asyncio.gather(*[place_file(session, url) for url in urls])
        return urls


def setup_args():
    icons_help_string = """This script aims to ease tutorial/CI data management."""

    parser = argparse.ArgumentParser(
        description="argopy tutorial/CI data manager",
        formatter_class=argparse.RawTextHelpFormatter,
        epilog="%s\n(c) Argo-France/Ifremer/LOPS, 2023-2026" % icons_help_string,
    )

    def choicesDescriptions():
        return """
       destination  - return absolute path to tutorial/CI data storage folder 
       download     - download all tutorial/CI data
       list         - list available tutorial/CI data
       clean        - delete all tutorial/CI data and associated files
    """

    def getChoices():
        return ["list", "destination", "download", "clean"]

    parser.add_argument(
        "-a",
        "--action",
        choices=getChoices(),
        help="action to perform among: %s" % choicesDescriptions(),
        metavar="",
    )
    parser.add_argument(
        "-f",
        "--force",
        help="Force write on data files even if they already exist",
        action="store_true",
    )

    return parser


